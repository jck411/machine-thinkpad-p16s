+import { afterEach, expect, it, vi } from 'vitest'
+
+import { restartRemoteBackend } from './backend-remote-restart'
+
+afterEach(() => vi.useRealTimers())
+
+it('waits through the old process and an outage until a new process answers', async () => {
+  vi.useFakeTimers()
+  const request = vi.fn()
+    .mockResolvedValueOnce({ ok: true, instance_id: 'old' })
+    .mockResolvedValueOnce({ instance_id: 'old' })
+    .mockRejectedValueOnce(new Error('502 Bad Gateway'))
+    .mockResolvedValueOnce({ instance_id: 'new' })
+  let finished = false
+  const restart = restartRemoteBackend(request).then(() => { finished = true })
+
+  await vi.advanceTimersByTimeAsync(2_000)
+  expect(finished).toBe(false)
+  await vi.advanceTimersByTimeAsync(1_000)
+  await restart
+  expect(request.mock.calls.filter(([, options]) => options.method === 'POST')).toHaveLength(1)
+})
+
+it('reports a refused restart and a backend that never replaces its process', async () => {
+  vi.useFakeTimers()
+  const denied = vi.fn().mockRejectedValue(new Error('403 Forbidden'))
+  await expect(restartRemoteBackend(denied)).rejects.toThrow('403 Forbidden')
+  expect(denied).toHaveBeenCalledTimes(1)
+
+  const request = vi.fn().mockResolvedValue({ instance_id: 'old' })
+    .mockResolvedValueOnce({ ok: true, instance_id: 'old' })
+  const result = expect(restartRemoteBackend(request, 2_000)).rejects.toThrow('did not return')
+  await vi.advanceTimersByTimeAsync(2_000)
+  await result
+})
