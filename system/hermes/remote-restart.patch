+type Request = (path: string, options: { method?: string; timeoutMs: number }) => Promise<any>
+
+/** Keep all requests pinned to the backend selected when the user clicked. */
+export async function restartRemoteBackend(request: Request, timeoutMs = 90_000): Promise<void> {
+  const accepted = await request('/api/backend/restart', { method: 'POST', timeoutMs: 10_000 })
+
+  if (accepted?.ok !== true || typeof accepted.instance_id !== 'string' || !accepted.instance_id) {
+    throw new Error('The backend did not acknowledge the restart.')
+  }
+
+  const deadline = Date.now() + timeoutMs
+
+  while (Date.now() < deadline) {
+    await new Promise(resolve => setTimeout(resolve, 1_000))
+
+    let runtime
+
+    try {
+      runtime = await request('/api/backend/runtime', { timeoutMs: Math.min(5_000, Math.max(1, deadline - Date.now())) })
+    } catch {
+      // Connection failures and proxy 502s are expected during the restart.
+      continue
+    }
+
+    if (typeof runtime?.instance_id === 'string' && runtime.instance_id && runtime.instance_id !== accepted.instance_id) {
+      return
+    }
+  }
+
+  throw new Error('The backend did not return after restarting. Check the server service and reconnect.')
+}
